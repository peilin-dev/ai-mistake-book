# Copy to deploy/.env on the server and fill in. Never commit the real file.
# deploy/deploy.ps1 creates it on the first deploy with random passwords; the WeChat and model keys are yours to add.

MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

WX_APPID=
WX_SECRET=
# Version of the mini program opened by the web-login QR code: trial (体验版, default) or release (after publishing).
# WX_QR_ENV_VERSION=trial

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARK_API_KEY=
DEEPSEEK_API_KEY=
